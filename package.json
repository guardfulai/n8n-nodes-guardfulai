{
  "name": "n8n-nodes-guardfulai",
  "version": "0.1.3",
  "description": "Check content and prepare dataset reporting with Guardful AI",
  "license": "MIT",
  "homepage": "https://www.guardfulai.com/integrations/n8n/",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "GuardfulAI",
    "email": "guardfultom@users.noreply.github.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/guardfulai/n8n-nodes-guardfulai.git"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "build:watch": "node node_modules/typescript/bin/tsc --watch",
    "dev": "n8n-node dev",
    "qa:local": "node scripts/qa-local.mjs",
    "qa:prepare": "node scripts/qa-local.mjs --prepare",
    "qa:verify": "node scripts/qa-verify.mjs",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease",
    "test": "node --test test/*.test.mjs",
    "check:package": "node scripts/check-package.mjs",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "qa:starter": "node scripts/qa-starter.mjs",
    "check:community": "node scripts/check-community.mjs source",
    "check:published": "node scripts/check-community.mjs published"
  },
  "files": [
    "dist/nodes",
    "dist/credentials"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/GuardfulAIApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/GuardfulAI/Guardfulai.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "0.51.3",
    "@n8n/scan-community-package": "0.39.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^21.1.0",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  },
  "bugs": {
    "url": "https://github.com/guardfulai/n8n-nodes-guardfulai/issues"
  },
  "engines": {
    "node": ">=24"
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  }
}
